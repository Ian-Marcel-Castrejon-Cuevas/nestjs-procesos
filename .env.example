# Copia este archivo como .env y completa valores solo en tu entorno local.
# No uses credenciales reales en ejercicios ni en archivos versionados.

PORT=3001
DEMO_MODE=false

# Base de datos principal
DB_SERVER=localhost
DB_PORT=1433
DB_USER=usuario_local
DB_PASSWORD=CAMBIAR_EN_ENTORNO_LOCAL
DB_DATABASE=base_local

# Base de datos de origen para reportes
DB_ORIGEN_USER=usuario_local
DB_ORIGEN_PASSWORD=CAMBIAR_EN_ENTORNO_LOCAL
DB_ORIGEN_SERVER=localhost
DB_ORIGEN_DATABASE=base_origen_local
DB_ORIGEN_PORT=1433
DB_ORIGEN_SCHEMA=dbo
DB_ORIGEN_TABLE=tabla_origen

# Portal de reportes
PORTAL_BASE_URL=https://example.invalid/portal
PORTAL_USER=usuario_local
PORTAL_PASSWORD=CAMBIAR_EN_ENTORNO_LOCAL

# CCC downloader
CCC_USERNAME=usuario_local
CCC_PASSWORD=CAMBIAR_EN_ENTORNO_LOCAL
DB_HOST2=localhost
DB_PORT2=1433
DB_USERNAME2=usuario_local
DB_PASSWORD2=CAMBIAR_EN_ENTORNO_LOCAL
DB_DATABASE2=base_ccc_local

# Módulo de phishing educativo
PHISHING_ADMIN_PASSWORD=CAMBIAR_EN_ENTORNO_LOCAL

# IMAP para test-groupwise.js
IMAP_HOST=localhost
IMAP_PORT=993
IMAP_USERNAME=usuario_local
IMAP_PASSWORD=CAMBIAR_EN_ENTORNO_LOCAL
IMAP_TLS=true
